# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://www.ravidassiaabroad.com

# Database
PGHOST=your-supabase-pooler-host
PGPORT=5432
PGDATABASE=postgres
PGUSER=your-postgres-user
PGPASSWORD=your-postgres-password

# Auth
JWT_SECRET=replace_with_a_long_random_secret
AUTH_COOKIE_NAME=ra_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email
RESEND_API_KEY=re_replace_me
EMAIL_FROM=Ravidassia Abroad <no-reply@ravidassiaabroad.com>
PRIVACY_CONTACT_EMAIL=privacy@ravidassiaabroad.com
CONSENT_VERSION=2026-03-25

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Stripe donations
# Use sk_test_... first. Switch to sk_live_... only after sandbox checkout works.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_DONATION_CURRENCY=cad
